ble schema="main" name="waitlists" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="49"/><column index="2" value="130"/><column index="3" value="62"/><column index="4" value="62"/><column index="5" value="81"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT bid, b.member
FROM borrowings b, waitlists w
WHERE (b.end_date - b.start_date) &gt; 14
AND b.book_id = w.book_id
AND NOT w.priority &gt; 5 </sql><current_tab id="0"/></tab_sql></sqlb_project>
